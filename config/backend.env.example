# Copy to japz-backend/.env. Use a NEW isolated database, never the team database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=japz_inventory
DB_USER=inventory_app
DB_PASSWORD=
# Required: set a unique random JWT signing value of at least 32 bytes privately.
JWT_SECRET=
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
